# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/coverage-int
/test-results
/playwright-report
/tests/e2e/.auth
/.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example

# vercel
.vercel

# claude code runtime state (configs/agents/commands stay tracked)
/.claude/scheduled_tasks.lock
/.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# npm lockfile — this project uses pnpm. Worktrees sometimes get an
# `npm install` to work around a Turbopack symlink issue; that artifact
# must not be committed.
/package-lock.json

# Local dev-server log (see the run helper).
/dev.log

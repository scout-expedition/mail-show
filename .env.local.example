# Supabase project: mail-show (org: Scout Expedition Co, project id: qleuihyqfpnectqcqagx)
NEXT_PUBLIC_SUPABASE_URL=https://qleuihyqfpnectqcqagx.supabase.co

# Publishable (anon) key — safe to expose in the browser.
# Get it from https://supabase.com/dashboard/project/qleuihyqfpnectqcqagx/settings/api
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (for drizzle-kit migrations).
# Format: postgresql://postgres:<password>@db.qleuihyqfpnectqcqagx.supabase.co:5432/postgres
DATABASE_URL=

# Comma-separated list of emails allowed to sign in. Anyone else is blocked.
# Example: ALLOWED_EMAILS=you@example.com,teammate@example.com
ALLOWED_EMAILS=

# Comma-separated email domains also allowed (optional).
# Example: ALLOWED_EMAIL_DOMAINS=scoutexpedition.co
ALLOWED_EMAIL_DOMAINS=
